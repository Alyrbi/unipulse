# Environment configuration
APP_NAME=UniPulse
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Secret keys (must be provided via environment variable in production)
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# CORS origins
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:3000","http://localhost:3000"]

# LLM mock
MOCK_LLM_LATENCY_MS=50

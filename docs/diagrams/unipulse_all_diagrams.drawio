icalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontFamily=Times New Roman;fontSize=11;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="260" height="210" as="geometry" /></mxCell><mxCell id="m" value="&lt;b&gt;MEMBERSHIP&lt;/b&gt;&lt;br&gt;&lt;hr&gt;+ membership_id: UUID [PK]&lt;br&gt;# user_id: UUID [FK -&amp;gt; User]&lt;br&gt;# community_id: UUID [FK -&amp;gt; Comm]&lt;br&gt;+ role_in_comm: ENUM (admin, member)&lt;br&gt;+ joined_at: TIMESTAMP&lt;br&gt;&lt;i&gt;CONSTRAINT: UQ(user_id, comm_id)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontFamily=Times New Roman;fontSize=11;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="250" height="170" as="geometry" /></mxCell><mxCell id="comm" value="&lt;b&gt;COMMUNITY (Spaces)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;+ community_id: UUID [PK]&lt;br&gt;+ name: VARCHAR(100) [UQ]&lt;br&gt;+ type: ENUM (club, dept, interest)&lt;br&gt;# created_by: UUID [FK -&amp;gt; User]&lt;br&gt;+ created_at: TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontFamily=Times New Roman;fontSize=11;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="830" y="80" width="250" height="170" as="geometry" /></mxCell><mxCell id="audit" value="&lt;b&gt;AUDIT_LOG (Immutable)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;+ log_id: UUID [PK]&lt;br&gt;+ entity_name: VARCHAR(50)&lt;br&gt;+ entity_id: UUID&lt;br&gt;# actor_id: UUID [FK -&amp;gt; User]&lt;br&gt;+ action: ENUM (quarantine, ack)&lt;br&gt;+ reason: TEXT&lt;br&gt;+ created_at: TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontFamily=Times New Roman;fontSize=11;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1200" y="80" width="250" height="190" as="geometry" /></mxCell><mxCell id="draft" value="&lt;b&gt;DRAFT / POST_VERSION&lt;/b&gt;&lt;br&gt;&lt;hr&gt;+ draft_id: UUID [PK]&lt;br&gt;# post_id: UUID [FK -&amp;gt; Post, NULL]&lt;br&gt;+ version: INT [DEFAULT 1]&lt;br&gt;+ title: VARCHAR(120)&lt;br&gt;+ content: TEXT&lt;br&gt;# last_modified_by: UUID [FK -&amp;gt; User]&lt;br&gt;+ updated_at: TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontFamily=Times New Roman;fontSize=11;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="260" height="190" as="geometry" /></mxCell><mxCell id="post" value="&lt;b&gt;POST (Core Entity)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;+ post_id: UUID [PK]&lt;br&gt;+ title: VARCHAR(120)&lt;br&gt;+ content: TEXT (5-5000 chars)&lt;br&gt;# author_id: UUID [FK -&amp;gt; User]&lt;br&gt;+ audience: ENUM (pub, camp, club, fac)&lt;br&gt;# community_id: UUID [FK, NULLABLE]&lt;br&gt;+ status: ENUM (pub, flag, quarantine)&lt;br&gt;+ ai_summary: TEXT [NULLABLE]&lt;br&gt;+ created_at: TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontFamily=Times New Roman;fontSize=11;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="450" y="360" width="280" height="240" as="geometry" /></mxCell><mxCell id="cmt" value="&lt;b&gt;COMMENT&lt;/b&gt;&lt;br&gt;&lt;hr&gt;+ comment_id: UUID [PK]&lt;br&gt;# post_id: UUID [FK -&amp;gt; Post]&lt;br&gt;# author_id: UUID [FK -&amp;gt; User]&lt;br&gt;+ content: TEXT (1-1000 chars)&lt;br&gt;+ created_at: TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontFamily=Times New Roman;fontSize=11;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="850" y="360" wi
<mxfile host="app.diagrams.net" modified="2026-10-13T23:55:00.000Z" agent="UniPulse" version="21.0.0" type="device"><diagram id="c4-context" name="1. C4 Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b1" value="UniPulse System Boundary" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#333333;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="320" height="560" as="geometry" /></mxCell><mxCell id="unipulse_sys" value="&amp;lt;b&amp;gt;UniPulse Platform&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Software System]&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Central campus social network for publishing, real-time collaboration, and safe moderation." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=2;fillColor=#f5f5f5;fontColor=#000000;fontSize=13;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="490" y="260" width="220" height="180" as="geometry" /></mxCell><mxCell id="u1" value="&amp;lt;b&amp;gt;Student&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Person]&amp;lt;br&amp;gt;Discovers events, joins spaces, reads updates" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="50" height="90" as="geometry" /></mxCell><mxCell id="u2" value="&amp;lt;b&amp;gt;Club Executive&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Person]&amp;lt;br&amp;gt;Publishes announcements, creates campus events" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="50" height="90" as="geometry" /></mxCell><mxCell id="u3" value="&amp;lt;b&amp;gt;Faculty / Admin&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Person]&amp;lt;br&amp;gt;Broadcasts official notices and policies" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="120" y="440" width="50" height="90" as="geometry" /></mxCell><mxCell id="u4" value="&amp;lt;b&amp;gt;Moderator&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Person]&amp;lt;br&amp;gt;Enforces guidelines and triages flagged reports" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="575" y="690" width="50" height="90" as="geometry" /></mxCell><mxCell id="ext_sso" value="&amp;lt;b&amp;gt;University SSO / LDAP&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[External System]&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Verifies university credentials, enrollment, and faculty roles" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="200" height="100" as="geometry" /></mxCell><mxCell id="ext_llm" value="&amp;lt;b&amp;gt;LLM Provider API&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[External System]&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Processes announcement drafts to extract metadata and summaries" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="200" height="100" as="geometry" /></mxCell><mxCell id="ext_mail" value="&amp;lt;b&amp;gt;Campus SMTP Server&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[External System]&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Dispatches event reminder and moderation notification emails" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="900" y="460" width="200" height="100" as="geometry" /></mxCell><mxCell id="e1" value="Views feeds &amp; RSVPs [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="u1" target="unipulse_sys"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Co-drafts announcements [HTTPS, WSS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="u2" target="unipulse_sys"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Broadcasts notices [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="u3" target="unipulse_sys"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Triages reports [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="u4" target="unipulse_sys"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Authenticates identity [OAuth2/OIDC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="unipulse_sys" target="ext_sso"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Requests summaries [JSON/HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="unipulse_sys" target="ext_llm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Sends alert emails [SMTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="unipulse_sys" target="ext_mail"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c4-container" name="2. C4 Containers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b2" value="UniPulse System Boundary" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#333333;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="700" height="600" as="geometry" /></mxCell><mxCell id="c_spa" value="&amp;lt;b&amp;gt;Single Page Application&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Container: React 19, TypeScript]&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Provides user interface, rich-text editor, audience selectors, and real-time feed updates." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="220" height="140" as="geometry" /></mxCell><mxCell id="c_api" value="&amp;lt;b&amp;gt;Backend API Application&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Container: Python, FastAPI]&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Exposes REST endpoints, handles WebSocket collaboration channels, and enforces audience permissions." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="140" width="240" height="140" as="geometry" /></mxCell><mxCell id="c_db" value="&amp;lt;b&amp;gt;Relational Database&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Container: PostgreSQL]&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Persists accounts, spaces, posts, comments, moderation audit logs, and event records." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="420" width="170" height="160" as="geometry" /></mxCell><mxCell id="c_redis" value="&amp;lt;b&amp;gt;In-Memory Cache &amp;amp; PubSub&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Container: Redis]&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Caches hot feeds and brokers live WebSocket edit deltas across replicas." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="420" width="170" height="160" as="geometry" /></mxCell><mxCell id="u_user" value="&amp;lt;b&amp;gt;Campus User&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Student, Exec, Faculty]" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="50" height="90" as="geometry" /></mxCell><mxCell id="ext_llm_c" value="&amp;lt;b&amp;gt;LLM Provider API&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[External System]" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="170" width="130" height="80" as="geometry" /></mxCell><mxCell id="e2_1" value="Uses browser [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="u_user" target="c_spa"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_2" value="REST /api/* [JSON/HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="c_spa" target="c_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_3" value="Collaboration [WSS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="c_spa" target="c_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_4" value="SQL queries [TCP 5432]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="c_api" target="c_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_5" value="Cache &amp;amp; PubSub [RESP 6379]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="c_api" target="c_redis"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_6" value="Prompt request [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="c_api" target="ext_llm_c"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c4-component" name="3. C4 Components"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b3" value="FastAPI Backend Application Container" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#333333;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="160" y="60" width="840" height="600" as="geometry" /></mxCell><mxCell id="comp_post_r" value="&amp;lt;b&amp;gt;Post Router&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[FastAPI APIRouter]&amp;lt;br&amp;gt;Exposes REST endpoints for posts, drafts, and feed retrieval" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="180" height="80" as="geometry" /></mxCell><mxCell id="comp_ws_r" value="&amp;lt;b&amp;gt;WebSocket Router&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[FastAPI WebSocket]&amp;lt;br&amp;gt;Handles live collaborative editing rooms and diff syncing" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="180" height="80" as="geometry" /></mxCell><mxCell id="comp_mod_r" value="&amp;lt;b&amp;gt;Moderation Router&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[FastAPI APIRouter]&amp;lt;br&amp;gt;Handles abuse flagging, queue inspection, and appeals" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="180" height="80" as="geometry" /></mxCell><mxCell id="comp_guard" value="&amp;lt;b&amp;gt;Audience &amp;amp; Auth Guard&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Dependency / Middleware]&amp;lt;br&amp;gt;Validates session tokens and enforces audience rules" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=2;fillColor=#e1e1e1;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="250" width="320" height="60" as="geometry" /></mxCell><mxCell id="comp_post_s" value="&amp;lt;b&amp;gt;Post Service&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Domain Service]&amp;lt;br&amp;gt;Executes post publishing rules and version increments" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="360" width="180" height="80" as="geometry" /></mxCell><mxCell id="comp_ai_s" value="&amp;lt;b&amp;gt;PulseDigest AI Service&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Domain Service]&amp;lt;br&amp;gt;Calls LLM API, parses event tags, formats summaries" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="360" width="180" height="80" as="geometry" /></mxCell><mxCell id="comp_mod_s" value="&amp;lt;b&amp;gt;Moderation Service&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Domain Service]&amp;lt;br&amp;gt;Manages report thresholds, strikes, and audit records" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="360" width="180" height="80" as="geometry" /></mxCell><mxCell id="comp_repo" value="&amp;lt;b&amp;gt;Post &amp;amp; User Repository&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;[Data Access Layer]&amp;lt;br&amp;gt;Encapsulates SQL queries and data mapping" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f5f5f5;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="220" height="80" as="geometry" /></mxCell><mxCell id="e3_1" value="Guards request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="comp_post_r" target="comp_guard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_2" value="Guards socket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="comp_ws_r" target="comp_guard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_3" value="Guards action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="comp_mod_r" target="comp_guard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_4" value="Delegates domain logic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="comp_guard" target="comp_post_s"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_5" value="Delegates report triage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="comp_guard" target="comp_mod_s"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_6" value="Requests summary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="comp_post_s" target="comp_ai_s"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_7" value="Persists changes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="comp_post_s" target="comp_repo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_8" value="Updates status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="comp_mod_s" target="comp_repo"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="uml-sequence" name="4. UML Seq